# development | production. Em production, CONTENT_ENCRYPTION_KEY abaixo nao
# pode ficar no default commitado: a aplicacao recusa subir.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://mobia:mobia@localhost:5433/mobia
REDIS_URL=redis://localhost:6380/0
WHATSAPP_APP_SECRET=dev-app-secret
WHATSAPP_VERIFY_TOKEN=dev-verify-token
LOG_LEVEL=INFO

# 32 bytes em base64: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CONTENT_ENCRYPTION_KEY=ZGV2LWtleS0zMi1ieXRlcy1mb3ItbW9iaWEtb2shISE=

# Obrigatoria a partir do TEC-127. Sem ela o cliente do provedor recusa subir.
ANTHROPIC_API_KEY=

# Token de envio da Cloud API da Meta. Obrigatorio a partir do TEC-134.
WHATSAPP_ACCESS_TOKEN=
# RN-13.6 (TEC-186): nomes dos templates da Meta aprovados, separados por virgula.
# Vazio por padrao (RT-03): todo follow-up fora da janela de 24h vira tarefa do corretor.
WHATSAPP_TEMPLATES_APROVADOS=

# Habilita POST /api/v1/imoveis/importar. Vazio desliga a rota inteira.
CATALOGO_ADMIN_TOKEN=dev-catalogo-token

# Chave do provedor de embedding (TEC-157). NAO e a da Anthropic -- a API da
# Anthropic nao tem endpoint de embeddings. Sem ela o worker recusa subir em
# producao; em desenvolvimento a indexacao vetorial avisa UMA vez e nao indexa
# nada, entao o catalogo fica sem vetor e a busca devolve vazio.
OPENAI_API_KEY=

# SMTP da notificacao ao corretor (TEC-280). Obrigatorios: sem SMTP_HOST e
# SMTP_REMETENTE o worker recusa subir, em qualquer ambiente. Estes valores
# apontam para o Mailpit do docker-compose, que captura e nao entrega.
SMTP_HOST=localhost
SMTP_PORTA=1025
SMTP_REMETENTE=mobia@localhost
SMTP_STARTTLS=false
SMTP_USUARIO=
SMTP_SENHA=

# Rate limiting da RNF-16 (TEC-205). Zero desliga qualquer um dos dois.
# `ATRASO_DE_BACKOFF_SEGUNDOS` e quanto o excedente por numero espera a mais
# antes de virar turno; subi-lo esbarra na invariante do sweeper, ver
# test_job_timeout_cabe_dentro_da_janela_do_sweeper.
RATE_LIMIT_MENSAGENS_POR_MINUTO=20
RATE_LIMIT_REQUISICOES_POR_IP_POR_MINUTO=100
ATRASO_DE_BACKOFF_SEGUNDOS=30.0
# Ligue quando a API estiver atras de proxy/ingress; sem proxy, ligar isso
# deixa qualquer cliente escapar do limite forjando X-Forwarded-For.
CONFIAR_EM_FORWARDED_FOR=false

# Exportacao para CRM (TEC-180, RN-16.5). OPCIONAL, ao contrario do SMTP
# acima: com CRM_WEBHOOK_URL vazia a exportacao fica desligada e o worker sobe
# assim, avisando uma vez. Aponte para um coletor local (um `nc -l`, um
# webhook.site) para ver o payload.
CRM_WEBHOOK_URL=
# Sem segredo, o POST vai sem o cabecalho X-Mobia-Signature-256.
CRM_WEBHOOK_SECRET=

# Calendario (TEC-170). OPCIONAL: com GOOGLE_CALENDAR_REFRESH_TOKEN vazia a
# integracao fica desligada e o worker sobe com CalendarioNoop, avisando uma
# vez.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
