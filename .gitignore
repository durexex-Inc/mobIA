__pycache__/
*.py[cod]
.venv/
.env
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Scratch do fluxo de execucao por subagente (ledger, briefs, pacotes de
# revisao). E rastro de processo, nao artefato do projeto -- o registro que
# fica e o historico do git.
#
# A ferramenta ja cria um `.superpowers/sdd/.gitignore` com `*`, entao o que
# ela escreve la dentro ja estaria ignorado sem esta linha. O que esta linha
# acrescenta e a cobertura de `.superpowers/` INTEIRO: qualquer coisa que a
# ferramenta venha a escrever fora de `sdd/` nao depende de ela ter lembrado
# de plantar outro arquivo.
.superpowers/

# A TEC-224 tornou o build do wheel um passo de verificacao do gate de tipos
# e encontrou `build/` como artefato dele (`pip wheel --no-deps --wheel-dir
# <temp>`). `dist/` entra por precaucao, nao por medicao -- o plano usa
# `pip wheel`, nao `python -m build`, que e o que escreveria ali.
build/
dist/

# Frontend do painel: dependencia e build do Next, que sao artefato de
# maquina, nao codigo. O `frontend/.gitignore` ja cobre os dois (`/node_modules`
# e `/.next/`), e por isso estas duas linhas nao mudam nada hoje -- zero arquivo
# entra ou sai do versionamento por causa delas.
#
# O que elas acrescentam e nao depender daquele arquivo: se alguem reescrever o
# `frontend/.gitignore` ao trocar de ferramenta de build, `node_modules` nao
# volta a aparecer no `git status` por descuido.
#
# O resto de `frontend/` continua rastreado de proposito -- o painel da TEC-190
# e codigo do projeto.
frontend/node_modules/
frontend/.next/

# Midia recebida do lead (TEC-132), quando `midia_armazem=local` (o default de
# desenvolvimento). Conteudo cifrado de usuario, nao artefato de codigo.
.midias/
