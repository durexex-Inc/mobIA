# .env de PRODUCAO na VPS. Fica em /opt/app/.env, NUNCA no git, com backup
# seguro a parte. A compose (docker-compose.prod.yml) le estas variaveis.
# Copie para .env e preencha. Gere segredos com os comandos indicados.

# ── Dominio e TLS ────────────────────────────────────────────────────────────
# Dominio-base. A API responde em api.<dominio> e o painel em painel.<dominio>
# (crie os registros A apontando para o IP da VPS).
DOMINIO=seudominio.com.br
# E-mail para o Let's Encrypt (avisos de expiracao).
ACME_EMAIL=voce@seudominio.com.br

# ── Imagens (GHCR) ───────────────────────────────────────────────────────────
# Dono do pacote no GHCR, em MINUSCULAS (ex.: durexex-inc). O CI publica
# ghcr.io/<owner>/mobia-api e mobia-frontend.
GHCR_OWNER=durexex-inc
# Tag da imagem a rodar = SHA do commit. O deploy preenche; para build local
# use "latest".
IMAGE_TAG=latest

# ── Postgres (container interno) ─────────────────────────────────────────────
POSTGRES_USER=mobia
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=mobia

# ── Segredos da aplicacao (o app RECUSA subir com o default de dev) ──────────
# 32 bytes base64: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CONTENT_ENCRYPTION_KEY=
# segredos fortes: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SEGREDO=
AUDITORIA_CHAVE_DO_LEAD=
LEAD_INDICE_CHAVE=

# ── Provedores de IA ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=um-token-que-voce-escolhe
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATES_APROVADOS=

# ── SMTP (notificacao ao corretor; SMTP_HOST e SMTP_REMETENTE obrigatorios) ──
SMTP_HOST=
SMTP_PORTA=587
SMTP_REMETENTE=
SMTP_USUARIO=
SMTP_SENHA=
SMTP_STARTTLS=true

# ── Semente de producao (python -m mobia.admin.seed_producao) ────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=
SEED_ADMIN_NOME=Administrador

# ── Notas ────────────────────────────────────────────────────────────────────
# ENVIRONMENT=production, INFRA_INTERNA_CONFIAVEL=true, CONFIAR_EM_FORWARDED_FOR=true,
# DATABASE_URL e REDIS_URL sao definidos na compose (rede interna) -- nao aqui.
# As MOBIA_* do frontend tambem saem da compose, derivadas de DOMINIO.
